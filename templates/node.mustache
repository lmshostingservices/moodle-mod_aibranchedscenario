{{!
    @template mod_aibranchedscenario/node

    One decision point in the scenario.

    Classes required for JS:
    * aibs-choice

    Data attributes required for JS:
    * data-action="choose"
    * data-choiceid

    Context variables required for this template:
    * id string Node identifier
    * title string Short node title
    * stage int Narrative stage number
    * situationparas string Situation, array of plain-text paragraphs
    * speech string What a character says, plain text
    * challenge string The direct question put to the learner
    * challengeisquestion bool Whether that line already reads as a question
    * askwhatyoudo bool Whether the player supplies the question itself
    * speaker string Who says the speech line, or empty
    * speakerinitial string First letter of that name, for the avatar
    * hasspeaker bool Whether a named person says the line
    * hasspeechaudio bool Whether that line has a recording to play
    * crisis bool Whether the crisis variant is showing
    * imageurl string Scene image URL, or empty
    * imagealt string Scene image alternative text
    * hasimage bool Whether an image is present
    * choices array The available choices

    Example context (json):
    {
        "id": "n2",
        "title": "The fault nobody logged",
        "stage": 2,
        "situationparas": ["Sam lowers his voice."],
        "speech": "Can't we just fix it ourselves?",
        "challenge": "What do you say to Sam?",
        "challengeisquestion": true,
        "askwhatyoudo": false,
        "speaker": "Sam",
        "speakerinitial": "S",
        "hasspeaker": true,
        "hasspeechaudio": true,
        "crisis": false,
        "imageurl": "",
        "imagealt": "",
        "hasimage": false,
        "choices": [{"id": "n2_a", "letter": "A", "text": "Log the fault now and tell the supervisor."}]
    }
}}
<article class="aibs-card aibs-node aibs-slide aibs-enter {{^hasimage}}aibs-noscene{{/hasimage}}"
         data-nodeid="{{id}}" data-stage="{{stage}}">

    {{#hasimage}}
        <div class="aibs-scene">
            <img src="{{imageurl}}" alt="{{imagealt}}" class="aibs-scene-img" loading="lazy">
            {{#hasspeaker}}
                <span class="aibs-speaker">
                    {{#hasspeechaudio}}
                        <button type="button" class="aibs-avatar aibs-is-unplayed" data-action="speak"
                                title="{{#str}} listento, mod_aibranchedscenario, {{speaker}} {{/str}}"
                                aria-label="{{#str}} listento, mod_aibranchedscenario, {{speaker}} {{/str}}">
                            <span class="aibs-avatar-initial" aria-hidden="true">{{speakerinitial}}</span>
                            <svg class="aibs-icon aibs-avatar-play" viewBox="0 0 20 20"
                                 aria-hidden="true" focusable="false">
                                <path d="M7.4 5.6 14.2 10l-6.8 4.4Z" fill="currentColor"/>
                            </svg>
                        </button>
                    {{/hasspeechaudio}}
                    {{^hasspeechaudio}}
                        <span class="aibs-avatar aibs-is-silent">
                            <span class="aibs-avatar-initial" aria-hidden="true">{{speakerinitial}}</span>
                        </span>
                    {{/hasspeechaudio}}
                    <span class="aibs-speaker-name">{{speaker}}</span>
                    {{#hasspeechaudio}}
                        <span class="aibs-speaker-hint">
                            {{#str}} listento, mod_aibranchedscenario, {{speaker}} {{/str}}</span>
                    {{/hasspeechaudio}}
                </span>
            {{/hasspeaker}}
        </div>
    {{/hasimage}}

    <div class="aibs-node-body">
        <div class="aibs-node-head">
            <span class="aibs-chip">{{#str}} stagenumber, mod_aibranchedscenario, {{stage}} {{/str}}</span>
            {{#crisis}}
                <span class="aibs-chip aibs-chip-alert">
                    <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M10 2.6 18.4 17H1.6L10 2.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M10 7.8v4.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="10" cy="14.4" r="0.95" fill="currentColor"/>
                    </svg>
                    {{#str}} tensionhigh, mod_aibranchedscenario {{/str}}
                </span>
            {{/crisis}}
        </div>

        {{#title}}<h3 class="aibs-h3">{{title}}</h3>{{/title}}

        <div class="aibs-prose">{{#situationparas}}<p>{{.}}</p>{{/situationparas}}</div>

        {{#speech}}
            <blockquote class="aibs-speech">
                <svg class="aibs-icon aibs-speech-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M3 5.4A1.9 1.9 0 0 1 4.9 3.5h10.2A1.9 1.9 0 0 1 17 5.4v6.3a1.9 1.9 0 0 1-1.9 1.9H8.6L4.6 17v-3.4h-.7A1.9 1.9 0 0 1 3 11.7Z"
                          fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
                <p class="aibs-speech-text">{{speech}}</p>
            </blockquote>
        {{/speech}}

        {{#challenge}}
            <p class="aibs-challenge {{^challengeisquestion}}aibs-challenge-context{{/challengeisquestion}}">
                {{challenge}}</p>
        {{/challenge}}

        {{#askwhatyoudo}}
            <p class="aibs-challenge aibs-challenge-ask">
                {{#str}} whatdoyoudo, mod_aibranchedscenario {{/str}}</p>
        {{/askwhatyoudo}}

        {{#iscontinue}}
            <div class="aibs-continuewrap">
                {{#choices}}
                    <button type="button" class="aibs-btn aibs-btn-primary aibs-continuebtn"
                            data-action="choose" data-choiceid="{{id}}">
                        <span class="aibs-choice-text">{{text}}</span>
                        <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                            <path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                {{/choices}}
            </div>
        {{/iscontinue}}

        {{^iscontinue}}
        <fieldset class="aibs-choices">
            <legend class="aibs-visually-hidden">{{#str}} choosealegend, mod_aibranchedscenario {{/str}}</legend>
            {{#choices}}
                <button type="button" class="aibs-choice" data-action="choose" data-choiceid="{{id}}">
                    <span class="aibs-choice-letter" aria-hidden="true">{{letter}}</span>
                    <span class="aibs-choice-text">{{text}}</span>
                    <svg class="aibs-icon aibs-choice-arrow" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M4 10h11m-4.4-4.6L15.2 10l-4.6 4.6" fill="none" stroke="currentColor"
                              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            {{/choices}}
        </fieldset>
        {{/iscontinue}}
    </div>
</article>
