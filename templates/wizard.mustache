{{!
    @template mod_aibranchedscenario/wizard

    The five step authoring wizard, the generation panel and the node text editor.

    Classes required for JS:
    * aibs-wizard

    Data attributes required for JS:
    * data-region="wizard"
    * data-step
    * data-action

    Context variables required for this template:
    * cmid int Course module id
    * themeclass string CSS class applying the chosen accent theme
    * viewurl string URL of the learner view
    * aiavailable bool Whether the service is configured AND this person may generate
    * canpublish bool Whether this person may publish
    * cannotgenerate bool Configured, but this person may not spend credits
    * published bool Whether a revision is published
    * revision int Current published revision number
    * hasdraft bool Whether a working copy exists
    * source object Stored wizard values
    * characters array Four character slots
    * principles array Decision principles
    * hasprinciples bool Whether principles are present
    * nodes array Nodes of the working copy
    * nodecount int Number of nodes
    * decisions int How many decisions every scenario contains
    * industries array Option list
    * settings array Option list
    * atmospheres array Option list
    * whyhard array Option list
    * stakes array Option list
    * tones array Option list
    * tier int Which stored rung this writes; always one
    * complexities array Option list for how hard the scenario is
    * imagestyles array Option list
    * openingmetrics array Opening dynamics
    * maxsourcechars int Character ceiling for pasted content

    Example context (json):
    {
        "cmid": 42,
        "themeclass": "aibs-theme-slate",
        "viewurl": "https://example.com/mod/aibranchedscenario/view.php?id=42",
        "aiavailable": true,
        "canpublish": true,
        "cannotgenerate": false,
        "published": false,
        "revision": 0,
        "hasdraft": false,
        "source": {"brief": "", "sourcecontent": "", "title": "", "audience": "", "openingsituation": "", "centralproblem": "", "participantrole": "", "imageprompt": ""},
        "characters": [{"index": 0, "position": 1, "name": "", "role": "", "trait": "", "appearance": ""}],
        "principles": [],
        "hasprinciples": false,
        "nodes": [],
        "nodecount": 0,
        "decisions": 5,
        "industries": [{"key": "training", "label": "Training and assessment", "selected": true}],
        "settings": [{"key": "trainingroom", "label": "Training room", "selected": true, "industrykeys": "training", "hide": false}],
        "atmospheres": [{"key": "tension", "label": "Tension building", "selected": true}],
        "whyhard": [{"key": "timepressure", "label": "Time pressure", "selected": false}],
        "stakes": [{"key": "teamtrust", "label": "Team trust", "selected": false}],
        "tones": [{"key": "neutral", "label": "Neutral", "selected": true}],
        "tier": 1,
        "complexities": [{"key": "foundation", "label": "Foundation", "selected": true}],
        "imagestyles": [{"key": "cinematic", "label": "Cinematic", "selected": true}],
        "openingmetrics": [{"key": "trust", "label": "Trust", "value": 50}],
        "maxsourcechars": 60000
    }
}}
<div class="aibs-wizard {{themeclass}}" data-region="wizard" data-cmid="{{cmid}}" data-tier="{{tier}}">
    <div class="aibs-shell">

        {{^aiavailable}}
            {{! Two different reasons the AI controls are not here, and a teacher needs to
                know which: the site has no credentials, or this account may not spend them. }}
            {{#cannotgenerate}}
            <div class="aibs-error" role="alert">{{#str}} error:nogeneratecap, mod_aibranchedscenario {{/str}}</div>
            {{/cannotgenerate}}
            {{^cannotgenerate}}
            <div class="aibs-error" role="alert">{{#str}} error:nocredentials, mod_aibranchedscenario {{/str}}</div>
            {{/cannotgenerate}}
        {{/aiavailable}}

        {{! THE START SCREEN.
            A teacher opening this used to meet a page of explanation before a single
            question. What somebody needs before they begin is one number - what it costs -
            and a way in. The steps themselves say how it works, which is what steps are for. }}
        <section class="aibs-card aibs-start" data-region="start">
            <h3 class="aibs-h3">{{#str}} start:heading, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-start-lead">{{#str}} start:lead, mod_aibranchedscenario {{/str}}</p>

            <div class="aibs-pricing" data-region="pricing">
                <div class="aibs-pricing-head">
                    <h4 class="aibs-h4">{{#str}} pricing:heading, mod_aibranchedscenario {{/str}}</h4>
                    <span class="aibs-pricing-now">{{pricing.amount}}</span>
                </div>
                <ul class="aibs-pricing-list">
                    {{#pricing.rows}}
                        <li class="aibs-pricing-row {{#current}}aibs-is-current{{/current}}">
                            <span class="aibs-pricing-label">{{label}}</span>
                            <span class="aibs-pricing-amount">{{amount}}</span>
                        </li>
                    {{/pricing.rows}}
                </ul>
                <p class="aibs-fineprint">{{#str}} start:costnote, mod_aibranchedscenario {{/str}}</p>
            </div>

            <ul class="aibs-reading">
                {{#reading}}
                    <li class="aibs-reading-item">
                        <a class="aibs-reading-link" href="{{url}}" target="_blank" rel="noopener noreferrer">
                            {{title}}
                            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                                <path d="M8 4H4.6v11.4H16V12M11.4 4H16v4.6M16 4l-6.4 6.4" fill="none"
                                      stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                      stroke-linejoin="round"/>
                            </svg>
                        </a>
                        <span class="aibs-reading-body">{{body}}</span>
                    </li>
                {{/reading}}
            </ul>

            <div class="aibs-start-actions">
                <button type="button" class="aibs-btn aibs-btn-primary aibs-btn-lg" data-action="begin">
                    {{#str}} start:build, mod_aibranchedscenario {{/str}}</button>
                {{#hasdraft}}
                    <a class="aibs-btn aibs-btn-secondary" href="{{reviewurl}}">
                        {{#str}} reviewdraft, mod_aibranchedscenario {{/str}}</a>
                {{/hasdraft}}
            </div>
        </section>

        <div class="aibs-wizard-body" data-region="wizardbody" hidden>
        <ol class="aibs-wizard-steps" data-region="steps">
            <li><button type="button" class="aibs-wizard-step" data-action="gotostep" data-step="1" aria-current="step">1. {{#str}} step:content, mod_aibranchedscenario {{/str}}</button></li>
            <li><button type="button" class="aibs-wizard-step" data-action="gotostep" data-step="2">2. {{#str}} step:scene, mod_aibranchedscenario {{/str}}</button></li>
            <li><button type="button" class="aibs-wizard-step" data-action="gotostep" data-step="3">3. {{#str}} step:challenge, mod_aibranchedscenario {{/str}}</button></li>
            <li><button type="button" class="aibs-wizard-step" data-action="gotostep" data-step="4">4. {{#str}} step:people, mod_aibranchedscenario {{/str}}</button></li>
            <li><button type="button" class="aibs-wizard-step" data-action="gotostep" data-step="5">5. {{#str}} step:design, mod_aibranchedscenario {{/str}}</button></li>
            <li><button type="button" class="aibs-wizard-step" data-action="gotostep" data-step="6">6. {{#str}} step:build, mod_aibranchedscenario {{/str}}</button></li>
        </ol>

        <div class="aibs-error" data-region="error" role="alert" hidden></div>

        {{! A strip at the top of a long form, while a teacher watches the button they
            pressed at the bottom of it. Worse, it left the page fully usable: the button
            could be pressed again, the browser could be navigated away from, and a
            generation that was actually running looked like nothing had happened.

            It is a modal now. It covers the form, it says what is being made rather than
            just "working", and it cannot be dismissed while the work is in flight - there
            is no close control, Escape does nothing, and the page will not be left. }}
        <div class="aibs-workscrim" data-region="loading" role="status" aria-live="polite" hidden>
            <div class="aibs-worksheet" role="dialog" aria-modal="true"
                 aria-labelledby="aibs-worktitle" data-region="workdialog" tabindex="-1">
                <span class="aibs-spinner aibs-work-spinner" aria-hidden="true"></span>
                <h3 class="aibs-h3 aibs-loading-text" id="aibs-worktitle" data-region="loadingtext">
                    {{#str}} working, mod_aibranchedscenario {{/str}}</h3>
                <ul class="aibs-worksteps" data-region="worksteps"></ul>
                <p class="aibs-loading-eta" data-region="loadingeta" hidden>{{generationeta}}</p>
                <p class="aibs-worknote">{{#str}} worknote, mod_aibranchedscenario {{/str}}</p>
                <span class="aibs-sr-only" role="status" aria-live="polite"
                      data-region="worklive"></span>
            </div>
        </div>

        <section class="aibs-card" data-region="step" data-step="1">
            <h3 class="aibs-h3">{{#str}} step:content, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-step-lead">{{#str}} step:contentlead, mod_aibranchedscenario {{/str}}</p>
            {{! TWO WAYS IN, AS TWO CARDS.
                A paste box, an autofill button, a disclosure holding a prompt to copy and a
                second box to paste the answer back: four controls for one question, and a
                teacher had to read all four to find out which was theirs. }}
            <div class="aibs-choicecards" role="group" aria-labelledby="aibs-route-label">
                <span class="aibs-sr-only" id="aibs-route-label">
                    {{#str}} route:question, mod_aibranchedscenario {{/str}}</span>
                <button type="button" class="aibs-choicecard" data-action="route" data-route="own"
                        aria-pressed="true">
                    <span class="aibs-choicecard-title">
                        {{#str}} route:own, mod_aibranchedscenario {{/str}}</span>
                    <span class="aibs-choicecard-body">
                        {{#str}} route:ownbody, mod_aibranchedscenario {{/str}}</span>
                </button>
                <button type="button" class="aibs-choicecard" data-action="route" data-route="assistant"
                        aria-pressed="false">
                    <span class="aibs-choicecard-title">
                        {{#str}} route:assistant, mod_aibranchedscenario {{/str}}</span>
                    <span class="aibs-choicecard-body">
                        {{#str}} route:assistantbody, mod_aibranchedscenario {{/str}}</span>
                </button>
            </div>

            <div class="aibs-route" data-route-panel="own">
            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-sourcecontent">
                    {{#str}} field:sourcecontent, mod_aibranchedscenario {{/str}}
                    {{! The one input generation genuinely needs. It carried no marker, so a
                        teacher found out by pressing Generate, confirming the price, and
                        being refused. }}
                    <span class="aibs-required">{{#str}} field:required, mod_aibranchedscenario {{/str}}</span></label>
                <span class="aibs-field-hint" id="aibs-sourcecontent-hint">
                    {{#str}} field:sourcecontenthint, mod_aibranchedscenario, {{maxsourcechars}} {{/str}}</span>
                <textarea class="aibs-textarea" id="aibs-sourcecontent" data-field="sourcecontent" rows="10"
                    aria-describedby="aibs-sourcecontent-hint" maxlength="{{maxsourcechars}}">{{source.sourcecontent}}</textarea>
                {{! The count says whether what is in the box is the right AMOUNT, while
                    there is still time to do something about it. A teacher who pastes a
                    heading and two bullets otherwise finds out by reading a generic
                    scenario they have already paid for. Polite until it is worth saying
                    something - see sourceCount() in wizard.js. }}
                <p class="aibs-sourcecount" data-region="sourcecount" role="status"
                   aria-live="polite"></p>
            </div>

            {{! WHAT GOES IN THE BOX.

                Teachers ask what "source content" means, and the honest answer is specific
                enough that showing beats describing. Closed by default: somebody who
                already knows what to paste should not have to scroll past six hundred
                words to reach the box. }}
            <details class="aibs-disclosure">
                <summary class="aibs-disclosure-summary">
                    {{#str}} sourceexample, mod_aibranchedscenario {{/str}}</summary>
                <div class="aibs-disclosure-body">
                    <h4 class="aibs-h4">{{#str}} sourceexamplewhat, mod_aibranchedscenario {{/str}}</h4>
                    <div class="aibs-prose aibs-prose-small">
                        {{#str}} sourceexamplebody, mod_aibranchedscenario {{/str}}</div>
                    <p class="aibs-field-hint">
                        {{#str}} sourceexamplelead, mod_aibranchedscenario {{/str}}</p>
                    <pre class="aibs-promptsource" data-region="sourceexample">{{#str}} sourceexampletext, mod_aibranchedscenario {{/str}}</pre>
                    <button type="button" class="aibs-btn aibs-btn-secondary" data-action="useexample">
                        {{#str}} useexample, mod_aibranchedscenario {{/str}}</button>
                </div>
            </details>

            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-brief">
                    {{#str}} field:brief, mod_aibranchedscenario {{/str}}</label>
                <span class="aibs-field-hint">{{#str}} field:briefhint, mod_aibranchedscenario {{/str}}</span>
                <textarea class="aibs-textarea" id="aibs-brief" data-field="brief" rows="3">{{source.brief}}</textarea>
            </div>

            {{#aiavailable}}
                <button type="button" class="aibs-btn aibs-btn-primary" data-action="populate">
                    {{#str}} autofill, mod_aibranchedscenario {{/str}}
                </button>
                <p class="aibs-field-hint">{{#str}} autofillhint, mod_aibranchedscenario {{/str}}</p>
            {{/aiavailable}}

            </div>

            <div class="aibs-route" data-route-panel="assistant" hidden>
                <div class="aibs-routebody">
                    <p class="aibs-field-hint">{{#str}} draftelsewherehint, mod_aibranchedscenario {{/str}}</p>
                    <button type="button" class="aibs-btn aibs-btn-secondary" data-action="copyprompt">
                        {{#str}} copyprompt, mod_aibranchedscenario {{/str}}</button>
                    <p class="aibs-field-hint">{{#str}} copyprompthint, mod_aibranchedscenario {{/str}}</p>
                    <pre class="aibs-promptsource" data-region="promptsource" hidden>{{importprompt}}</pre>
                    <label class="aibs-field-label" for="aibs-import">
                        {{#str}} field:importjsonpaste, mod_aibranchedscenario {{/str}}</label>
                    {{! The one thing a teacher pasting a scenario needs to know about money,
                        and it was written, defined, and rendered nowhere. }}
                    <span class="aibs-field-hint">
                        {{#str}} field:importjsonhint, mod_aibranchedscenario {{/str}}</span>
                    <textarea class="aibs-textarea" id="aibs-import" data-region="import" rows="6"></textarea>
                    <button type="button" class="aibs-btn aibs-btn-secondary" data-action="import">
                        {{#str}} importdefinition, mod_aibranchedscenario {{/str}}</button>
                </div>
            </div>

        </section>

        <section class="aibs-card" data-region="step" data-step="2" hidden>
            <h3 class="aibs-h3">{{#str}} step:scene, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-step-lead">{{#str}} step:scenelead, mod_aibranchedscenario {{/str}}</p>
            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-industry-label">
                    {{#str}} field:industry, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-industry-label"
                     data-group="industry" data-multiple="0" data-default="{{defaults.industry}}">
                    {{#industries}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/industries}}
                </div>
                <div class="aibs-otherfield" hidden>
                    <label class="aibs-field-hint" for="aibs-industryother">
                        {{#str}} field:industryother, mod_aibranchedscenario {{/str}}</label>
                    <input type="text" class="aibs-input" id="aibs-industryother" data-field="industryother"
                        data-otherfor="industry" value="{{source.industryother}}" maxlength="120">
                </div>
            </div>

            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-setting-label">
                    {{#str}} field:setting, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-setting-label"
                     data-group="setting" data-multiple="0" data-default="{{defaults.setting}}">
                    {{! Filtered by the industry above: a hospitality teacher is shown a
                        kitchen, a bar and a function room rather than a list that opens
                        with "Mine site". }}
                    {{#settings}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            data-industries="{{industrykeys}}"{{#hide}} hidden{{/hide}}
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/settings}}
                </div>
                <div class="aibs-otherfield" hidden>
                    <label class="aibs-field-hint" for="aibs-settingother">
                        {{#str}} field:settingother, mod_aibranchedscenario {{/str}}</label>
                    <input type="text" class="aibs-input" id="aibs-settingother" data-field="settingother"
                        data-otherfor="setting" value="{{source.settingother}}" maxlength="255">
                </div>
            </div>

            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-atmosphere-label">
                    {{#str}} field:atmosphere, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-atmosphere-label"
                     data-group="atmosphere" data-multiple="0" data-default="{{defaults.atmosphere}}">
                    {{#atmospheres}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/atmospheres}}
                </div>
            </div>

            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-openingsituation">
                    {{#str}} field:openingsituation, mod_aibranchedscenario {{/str}}</label>
                <span class="aibs-field-hint">{{#str}} field:openingsituationhint, mod_aibranchedscenario {{/str}}</span>
                <textarea class="aibs-textarea" id="aibs-openingsituation" data-field="openingsituation"
                    rows="5">{{source.openingsituation}}</textarea>
            </div>
        </section>

        <section class="aibs-card" data-region="step" data-step="3" hidden>
            <h3 class="aibs-h3">{{#str}} step:challenge, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-step-lead">{{#str}} step:challengelead, mod_aibranchedscenario {{/str}}</p>

            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-centralproblem">
                    {{#str}} field:centralproblem, mod_aibranchedscenario {{/str}}</label>
                <span class="aibs-field-hint">{{#str}} field:centralproblemhint, mod_aibranchedscenario {{/str}}</span>
                <textarea class="aibs-textarea" id="aibs-centralproblem" data-field="centralproblem"
                    rows="4">{{source.centralproblem}}</textarea>
            </div>

            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-whyhard-label">
                    {{#str}} field:whyhard, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-whyhard-label"
                     data-group="whyhard" data-multiple="1">
                    {{#whyhard}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/whyhard}}
                </div>
            </div>

            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-stakes-label">
                    {{#str}} field:stakes, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-stakes-label"
                     data-group="stakes" data-multiple="1">
                    {{#stakes}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/stakes}}
                </div>
            </div>
        </section>

        <section class="aibs-card" data-region="step" data-step="4" hidden>
            <h3 class="aibs-h3">{{#str}} step:people, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-step-lead">{{#str}} step:peoplelead, mod_aibranchedscenario {{/str}}</p>

            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-participantrole">
                    {{#str}} field:participantrole, mod_aibranchedscenario {{/str}}</label>
                <span class="aibs-field-hint">{{#str}} field:participantrolehint, mod_aibranchedscenario {{/str}}</span>
                <input type="text" class="aibs-input" id="aibs-participantrole" data-field="participantrole"
                    value="{{source.participantrole}}" maxlength="255">
            </div>

            <p class="aibs-field-hint aibs-characters-intro">
                {{#str}} field:charactersintro, mod_aibranchedscenario {{/str}}</p>

            {{! FOUR IDENTICAL EMPTY SLOTS READ AS FOUR PEOPLE TO INVENT.
                Two is what the format can carry, and what the autofill aims at; the other
                two are there for the scenario that genuinely has four, behind a button. }}
            {{#characters}}
                <fieldset class="aibs-nodeedit{{#extra}} aibs-character-extra{{/extra}}"
                          data-character="{{index}}"{{#extra}} hidden{{/extra}}>
                    <legend class="aibs-field-label">
                        {{#str}} field:character, mod_aibranchedscenario, {{position}} {{/str}}</legend>
                    <div class="aibs-field">
                        <label class="aibs-field-label" for="aibs-charname-{{index}}">
                            {{#str}} field:charactername, mod_aibranchedscenario {{/str}}</label>
                        <input type="text" class="aibs-input" id="aibs-charname-{{index}}"
                            data-character-field="name" value="{{name}}" maxlength="80">
                    </div>
                    <div class="aibs-field">
                        <label class="aibs-field-label" for="aibs-charrole-{{index}}">
                            {{#str}} field:characterrole, mod_aibranchedscenario {{/str}}</label>
                        <input type="text" class="aibs-input" id="aibs-charrole-{{index}}"
                            data-character-field="role" value="{{role}}" maxlength="120">
                    </div>
                    <div class="aibs-field">
                        <label class="aibs-field-label" for="aibs-chartrait-{{index}}">
                            {{#str}} field:charactertrait, mod_aibranchedscenario {{/str}}</label>
                        <input type="text" class="aibs-input" id="aibs-chartrait-{{index}}"
                            data-character-field="trait" value="{{trait}}" maxlength="200">
                    </div>
                    <div class="aibs-field">
                        <label class="aibs-field-label" for="aibs-charlook-{{index}}">
                            {{#str}} field:characterappearance, mod_aibranchedscenario {{/str}}</label>
                        <input type="text" class="aibs-input" id="aibs-charlook-{{index}}"
                            data-character-field="appearance" value="{{appearance}}" maxlength="400">
                    </div>
                    {{! Not a description of the person. It chooses the voice this character's
                        spoken line is read in, and it is what keeps their face the same from
                        one scene image to the next. Nothing in the plugin was asking for it,
                        so both fell back on every scenario. }}
                    <div class="aibs-field">
                        <label class="aibs-field-label" for="aibs-chargender-{{index}}">
                            {{#str}} field:charactergender, mod_aibranchedscenario {{/str}}</label>
                        <select class="aibs-input" id="aibs-chargender-{{index}}"
                                data-character-field="gender">
                            {{! Three values, not two. The service can legitimately send
                                non-binary, and a select that cannot hold it meant a teacher
                                who opened the character to fix a typo silently reset the
                                field to "not set" - which then took the person's gender out
                                of the picture brief and let the image model choose. A field
                                the UI cannot express is a field the UI quietly destroys. }}
                            <option value="" {{^ismale}}{{^isfemale}}{{^isnonbinary}}selected{{/isnonbinary}}{{/isfemale}}{{/ismale}}>
                                {{#str}} field:charactergendernone, mod_aibranchedscenario {{/str}}</option>
                            <option value="female" {{#isfemale}}selected{{/isfemale}}>
                                {{#str}} gender:female, mod_aibranchedscenario {{/str}}</option>
                            <option value="male" {{#ismale}}selected{{/ismale}}>
                                {{#str}} gender:male, mod_aibranchedscenario {{/str}}</option>
                            <option value="non-binary" {{#isnonbinary}}selected{{/isnonbinary}}>
                                {{#str}} gender:nonbinary, mod_aibranchedscenario {{/str}}</option>
                        </select>
                        <p class="aibs-field-help">
                            {{#str}} field:charactergenderhelp, mod_aibranchedscenario {{/str}}</p>
                    </div>
                </fieldset>
            {{/characters}}

            <button type="button" class="aibs-btn aibs-btn-secondary" data-action="addcharacter"
                    data-region="addcharacter">
                {{#str}} addcharacter, mod_aibranchedscenario {{/str}}</button>
        </section>

        <section class="aibs-card" data-region="step" data-step="5" hidden>
            <h3 class="aibs-h3">{{#str}} step:design, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-step-lead">{{#str}} step:designlead, mod_aibranchedscenario {{/str}}</p>

            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-title">
                    {{#str}} field:title, mod_aibranchedscenario {{/str}}</label>
                <span class="aibs-field-hint">{{#str}} field:titlehint, mod_aibranchedscenario {{/str}}</span>
                <input type="text" class="aibs-input" id="aibs-title" data-field="title"
                    value="{{source.title}}" maxlength="255">
            </div>

            <div class="aibs-field">
                <label class="aibs-field-label" for="aibs-audience">
                    {{#str}} field:audience, mod_aibranchedscenario {{/str}}</label>
                <span class="aibs-field-hint">{{#str}} field:audiencehint, mod_aibranchedscenario {{/str}}</span>
                <input type="text" class="aibs-input" id="aibs-audience" data-field="audience"
                    value="{{source.audience}}" maxlength="255">
            </div>


            {{! The decision count used to be chosen here, anywhere from three to eight.
                It is fixed now, and the screen says so rather than leaving a teacher to
                wonder where the control went. Every extra decision was another set of
                options to write and another set of frames to pay for, and the debrief had
                to cope with all of it. }}
            <p class="aibs-field-note">
                {{#str}} field:decisionsfixed, mod_aibranchedscenario, {{decisions}} {{/str}}</p>

            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-tone-label">
                    {{#str}} field:tone, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-tone-label"
                     data-group="tone" data-multiple="0">
                    {{#tones}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/tones}}
                </div>
            </div>

            {{! How hard this scenario is, and the teacher decides. A progression is three
                activities, one at each level, sequenced with Moodle's own availability
                restrictions - not three scenarios stacked inside one activity. }}
            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-complexity-label">
                    {{#str}} field:complexity, mod_aibranchedscenario {{/str}}</span>
                <p class="aibs-field-hint">{{#str}} field:complexityhint, mod_aibranchedscenario {{/str}}</p>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-complexity-label"
                     data-group="complexity" data-multiple="0">
                    {{#complexities}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/complexities}}
                </div>
            </div>

            <div class="aibs-field">
                <span class="aibs-field-label" id="aibs-imagestyle-label">
                    {{#str}} field:imagestyle, mod_aibranchedscenario {{/str}}</span>
                <div class="aibs-optiongrid" role="group" aria-labelledby="aibs-imagestyle-label"
                     data-group="imagestyle" data-multiple="0">
                    {{#imagestyles}}
                        <button type="button" class="aibs-option" data-action="option" data-value="{{key}}"
                            aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                    {{/imagestyles}}
                </div>
            </div>

            {{! Two controls that matter to somebody tuning a scenario and to nobody
                building their first one. Behind one disclosure rather than in the way. }}
            <details class="aibs-disclosure">
                <summary class="aibs-disclosure-summary">
                    {{#str}} advanced, mod_aibranchedscenario {{/str}}</summary>
                <div class="aibs-disclosure-body">
                <div class="aibs-field">
                    <label class="aibs-field-label" for="aibs-imageprompt">
                        {{#str}} field:imageprompt, mod_aibranchedscenario {{/str}}</label>
                    <span class="aibs-field-hint">{{#str}} field:imageprompthint, mod_aibranchedscenario {{/str}}</span>
                    <input type="text" class="aibs-input" id="aibs-imageprompt" data-field="imageprompt"
                        value="{{source.imageprompt}}" maxlength="600">
                </div>

                {{! THREE BARE SLIDERS WITH NO HEADING AND NO NUMBERS.
                    They set where the room starts, which is neither look nor feel until somebody
                    says so, and a slider with no readout is a control you cannot set deliberately. }}
                <div class="aibs-field">
                    <span class="aibs-field-label" id="aibs-readings-label">
                        {{#str}} field:openingreadings, mod_aibranchedscenario {{/str}}</span>
                    <span class="aibs-field-hint">
                        {{#str}} field:openingreadingshint, mod_aibranchedscenario {{/str}}</span>
                    <div class="aibs-readings" role="group" aria-labelledby="aibs-readings-label">
                        {{#openingmetrics}}
                            <div class="aibs-reading-slider">
                                <label class="aibs-field-label" for="aibs-metric-{{key}}">{{label}}</label>
                                <input type="range" class="aibs-input" id="aibs-metric-{{key}}" min="0" max="100"
                                    step="5" data-metric-field="{{key}}" value="{{value}}"
                                    aria-describedby="aibs-metricvalue-{{key}}">
                                <output class="aibs-reading-value" id="aibs-metricvalue-{{key}}"
                                        data-metric-readout="{{key}}" for="aibs-metric-{{key}}">{{value}}</output>
                            </div>
                        {{/openingmetrics}}
                    </div>
                </div>
                </div>
            </details>
        </section>

        <section class="aibs-card" data-region="step" data-step="6" hidden>
            <h3 class="aibs-h3">{{#str}} step:build, mod_aibranchedscenario {{/str}}</h3>
            <p class="aibs-step-lead">{{#str}} step:buildlead, mod_aibranchedscenario {{/str}}</p>
            <p class="aibs-field-hint">{{#str}} generateexplain, mod_aibranchedscenario {{/str}}</p>
            {{#hasdraft}}
                <p class="aibs-field-hint">{{#str}} reviewdrafthint, mod_aibranchedscenario {{/str}}</p>
            {{/hasdraft}}

            <div class="aibs-brief-actions">
                {{#aiavailable}}
                    <button type="button" class="aibs-btn aibs-btn-primary" data-action="generate">
                        {{#str}} generatescenario, mod_aibranchedscenario {{/str}}
                    </button>
                {{/aiavailable}}
                {{#hasdraft}}
                    <a class="aibs-btn aibs-btn-secondary" href="{{reviewurl}}">
                        {{#str}} reviewdraft, mod_aibranchedscenario {{/str}}</a>
                    {{#hasprevious}}
                        <button type="button" class="aibs-btn aibs-btn-ghost" data-action="restoredraft"
                            title="{{#str}} restoredrafthint, mod_aibranchedscenario {{/str}}">
                            {{#str}} restoredraft, mod_aibranchedscenario {{/str}}</button>
                        {{! A tooltip is invisible on a touch screen, and this is the one
                            control on the page whose name does not say what it undoes. }}
                        <span class="aibs-field-hint aibs-restorehint">
                            {{#str}} restoredrafthint, mod_aibranchedscenario {{/str}}</span>
                    {{/hasprevious}}
                    {{#canpublish}}
                    <button type="button" class="aibs-btn aibs-btn-secondary" data-action="publish">
                        {{#str}} publishscenario, mod_aibranchedscenario {{/str}}
                    </button>
                    {{/canpublish}}
                {{/hasdraft}}
                {{#published}}
                    <a class="aibs-btn aibs-btn-ghost" href="{{viewurl}}">
                        {{#str}} previewscenario, mod_aibranchedscenario {{/str}}</a>
                {{/published}}
            </div>



            {{#published}}
                <p class="aibs-fineprint">
                    {{#str}} publishedrevision, mod_aibranchedscenario, {{revision}} {{/str}}</p>
            {{/published}}

            {{#hasdraft}}
                <div class="aibs-nodeeditor">
                    <h4 class="aibs-h4">{{#str}} editnodes, mod_aibranchedscenario, {{nodecount}} {{/str}}</h4>
                    {{#nodes}}
                        <div class="aibs-nodeedit" data-node="{{id}}">
                            <p class="aibs-field-label">
                                {{^isoutcome}}{{#str}} stagenumber, mod_aibranchedscenario, {{stage}} {{/str}}{{/isoutcome}}
                                {{#isoutcome}}{{#str}} field:ending, mod_aibranchedscenario {{/str}}{{/isoutcome}}
                            </p>
                            <div class="aibs-field">
                                <label class="aibs-field-label" for="aibs-node-title-{{id}}">
                                    {{#str}} field:nodetitle, mod_aibranchedscenario {{/str}}</label>
                                <input type="text" class="aibs-input" id="aibs-node-title-{{id}}"
                                    data-node-field="title" value="{{title}}" maxlength="160">
                            </div>
                            <div class="aibs-field">
                                <label class="aibs-field-label" for="aibs-node-situation-{{id}}">
                                    {{#str}} field:situation, mod_aibranchedscenario {{/str}}</label>
                                <textarea class="aibs-textarea" id="aibs-node-situation-{{id}}"
                                    data-node-field="situation" rows="4">{{situation}}</textarea>
                            </div>
                            {{^isoutcome}}
                                <div class="aibs-field">
                                    <label class="aibs-field-label" for="aibs-node-speech-{{id}}">
                                        {{#str}} field:facilitatorspeech, mod_aibranchedscenario {{/str}}</label>
                                    <textarea class="aibs-textarea" id="aibs-node-speech-{{id}}"
                                        data-node-field="facilitatorspeech" rows="2">{{facilitatorspeech}}</textarea>
                                </div>
                                <div class="aibs-field">
                                    <label class="aibs-field-label" for="aibs-node-challenge-{{id}}">
                                        {{#str}} field:challenge, mod_aibranchedscenario {{/str}}</label>
                                    <input type="text" class="aibs-input" id="aibs-node-challenge-{{id}}"
                                        data-node-field="challenge" value="{{challenge}}" maxlength="600">
                                </div>
                            {{/isoutcome}}
                            {{#isoutcome}}
                                <div class="aibs-field">
                                    <label class="aibs-field-label" for="aibs-node-summary-{{id}}">
                                        {{#str}} field:outcomesummary, mod_aibranchedscenario {{/str}}</label>
                                    <textarea class="aibs-textarea" id="aibs-node-summary-{{id}}"
                                        data-node-field="summary" rows="3">{{summary}}</textarea>
                                </div>
                            {{/isoutcome}}
                            {{#choices}}
                                <fieldset class="aibs-field" data-choice="{{id}}">
                                    <legend class="aibs-field-label">{{#str}} field:choice, mod_aibranchedscenario, {{letter}} {{/str}}</legend>
                                    <div class="aibs-choice-structure">
                                        <span class="aibs-choice-structure-item">
                                            <label class="aibs-field-label" for="aibs-choice-signal-{{id}}">
                                                {{#str}} field:signal, mod_aibranchedscenario {{/str}}</label>
                                            <select class="aibs-select" id="aibs-choice-signal-{{id}}"
                                                data-choice-field="signal">
                                                {{#signaloptions}}
                                                    <option value="{{key}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                                {{/signaloptions}}
                                            </select>
                                        </span>
                                        <span class="aibs-choice-structure-item">
                                            <label class="aibs-field-label" for="aibs-choice-next-{{id}}">
                                                {{#str}} field:leadsto, mod_aibranchedscenario {{/str}}</label>
                                            <select class="aibs-select" id="aibs-choice-next-{{id}}"
                                                data-choice-field="next">
                                                {{#targetoptions}}
                                                    <option value="{{key}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                                {{/targetoptions}}
                                            </select>
                                        </span>
                                    </div>
                                    <label class="aibs-field-label" for="aibs-choice-text-{{id}}">
                                        {{#str}} field:choicetext, mod_aibranchedscenario {{/str}}</label>
                                    <input type="text" class="aibs-input" id="aibs-choice-text-{{id}}"
                                        data-choice-field="text" value="{{text}}" maxlength="400">
                                    <label class="aibs-field-label" for="aibs-choice-cons-{{id}}">
                                        {{#str}} field:consequence, mod_aibranchedscenario {{/str}}</label>
                                    <textarea class="aibs-textarea" id="aibs-choice-cons-{{id}}"
                                        data-choice-field="consequence" rows="3">{{consequence}}</textarea>
                                    <label class="aibs-field-label" for="aibs-choice-fb-{{id}}">
                                        {{#str}} field:feedback, mod_aibranchedscenario {{/str}}</label>
                                    <textarea class="aibs-textarea" id="aibs-choice-fb-{{id}}"
                                        data-choice-field="feedback" rows="3">{{feedback}}</textarea>
                                    {{! The paragraph the debrief slide shows against this
                                        option. It was the one field the whole debrief is
                                        made of and the only one with no control here, so
                                        the review panel's advice to write one "in the
                                        editor" named something that did not exist. }}
                                    <label class="aibs-field-label" for="aibs-choice-note-{{id}}">
                                        {{#str}} field:outcomenote, mod_aibranchedscenario {{/str}}</label>
                                    <span class="aibs-field-hint">
                                        {{#str}} field:outcomenotehint, mod_aibranchedscenario {{/str}}</span>
                                    <textarea class="aibs-textarea" id="aibs-choice-note-{{id}}"
                                        data-choice-field="outcomenote" rows="3"
                                        maxlength="{{maxoutcomenote}}">{{outcomenote}}</textarea>
                                </fieldset>
                            {{/choices}}
                            <button type="button" class="aibs-btn aibs-btn-secondary" data-action="savenode">
                                {{#str}} savenode, mod_aibranchedscenario {{/str}}</button>
                        </div>
                    {{/nodes}}
                </div>
            {{/hasdraft}}
        </section>

        <div class="aibs-wizard-actions">
            <button type="button" class="aibs-btn aibs-btn-ghost" data-action="back">
                {{#str}} back, mod_aibranchedscenario {{/str}}</button>
            <div class="aibs-brief-actions">
                <button type="button" class="aibs-btn aibs-btn-secondary" data-action="save">
                    {{#str}} savedraft, mod_aibranchedscenario {{/str}}</button>
                <button type="button" class="aibs-btn aibs-btn-primary" data-action="next">
                    {{#str}} next, mod_aibranchedscenario {{/str}}</button>
            </div>
        </div>
        </div>
    </div>
</div>
