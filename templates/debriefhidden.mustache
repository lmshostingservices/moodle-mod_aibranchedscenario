{{!
    @template mod_aibranchedscenario/debriefhidden

    The end of the scenario for an activity whose teacher has turned the debrief off.

    Context variables required for this template:
    * allowreplay bool Whether the learner may start again

    Example context (json):
    {
        "allowreplay": true
    }
}}
<section class="aibs-card aibs-debrief-hidden">
    <h3 class="aibs-h3">{{#str}} attemptfinished, mod_aibranchedscenario {{/str}}</h3>
    <p class="aibs-prose">{{#str}} debriefhidden, mod_aibranchedscenario {{/str}}</p>
    {{#allowreplay}}
        <button type="button" class="aibs-btn aibs-btn-secondary" data-action="replay">
            {{#str}} tryagain, mod_aibranchedscenario {{/str}}</button>
    {{/allowreplay}}
</section>
