{{!
    @template mod_aibranchedscenario/debrief

    The closing outcome and learning debrief for a finished attempt.

    Classes required for JS:
    * aibs-debrief

    Data attributes required for JS:
    * data-action="replay"
    * data-action="print"
    * data-action="deckprev"
    * data-action="decknext"
    * data-region="deck"
    * data-region="deckslide"
    * data-region="deckcount"

    Context variables required for this template:
    * outcome string Outcome band reached
    * outcomeclass string CSS modifier for the outcome band
    * outcomelabel string Translated outcome band label
    * outcometitle string Title of the outcome node
    * outcomeparas string Outcome summary, array of plain-text paragraphs
    * score float Decision quality as a percentage
    * decisions int Number of decisions taken
    * radar array Skill values, each with label, percent and raw
    * journeypages array The decision journey, chunked one page at a time
    * whatmattered array Lessons demonstrated
    * criticaldecisions array Decisions that changed the outcome
    * practice array Behaviours to use in practice
    * sourceconnectionparas string How the lessons connect to the source content
    * hassourceconnection bool Whether a source connection is present
    * takeaways array Takeaway cards
    * hascritical bool Whether critical decisions are listed
    * haspractice bool Whether practice behaviours are listed
    * hastakeaways bool Whether takeaway cards are present
    * allowreplay bool Whether the learner may replay

    Example context (json):
    {
        "outcome": "mixed",
        "outcomeclass": "aibs-outcome-mixed",
        "outcomelabel": "Mixed outcome",
        "outcometitle": "The line restarts, late",
        "outcomeparas": ["The fault was fixed, but two hours were lost."],
        "score": 62.5,
        "decisions": 5,
        "radar": [{"skill": "clarity", "label": "Clarity", "percent": 70, "raw": 3}],
        "journeypages": [{"first": 1, "last": 1, "decisions": [{"seq": 1, "nodetitle": "The fault nobody logged", "choicetext": "Log it now", "signal": "positive", "signalclass": "aibs-signal-positive", "consequenceparas": ["Sam agrees."], "feedbackparas": ["Good call."], "hasfeedback": true, "principle": "Report faults early"}]}],
        "whatmattered": ["Faults are logged the moment they are seen."],
        "criticaldecisions": ["Choosing to log the fault rather than fix it quietly."],
        "practice": ["Log it, then fix it."],
        "sourceconnectionparas": ["Section 4.2 of the procedure."],
        "hassourceconnection": true,
        "hascritical": true,
        "haspractice": true,
        "hastakeaways": true,
        "takeaways": [{"heading": "Speak early", "bodyparas": ["Raising a fault early costs less than hiding it."]}],
        "allowreplay": true
    }
}}
<div class="aibs-debrief aibs-deck aibs-enter" data-region="deck">

    <div class="aibs-deck-stage">

        <section class="aibs-card aibs-deckslide aibs-slide aibs-outcome {{outcomeclass}} {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" data-audio="{{outcomeaudiourl}}">
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
            <div class="aibs-outcome-head">
                <span class="aibs-outcome-badge">{{outcomelabel}}</span>
                {{! The only thing saying this number was a decision-quality score used to
                    be an aria-label, which everyone who can see the screen cannot read. }}
                <div class="aibs-score">
                    <span class="aibs-score-figure">
                        <span class="aibs-score-value">{{score}}</span>
                        <span class="aibs-score-unit">%</span>
                    </span>
                    <span class="aibs-score-label">
                        {{#str}} score, mod_aibranchedscenario {{/str}}</span>
                </div>
            </div>
            {{#outcometitle}}<h3 class="aibs-h3">{{outcometitle}}</h3>{{/outcometitle}}
            <div class="aibs-prose aibs-prose-lead">{{#outcomeparas}}<p>{{.}}</p>{{/outcomeparas}}</div>
            <p class="aibs-fineprint">{{#str}} decisionstaken, mod_aibranchedscenario, {{decisions}} {{/str}}</p>
                    </div>
        </section>

        <section class="aibs-card aibs-deckslide aibs-slide aibs-skills {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" hidden>
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
            <h3 class="aibs-h3">{{#str}} howyouhandledit, mod_aibranchedscenario {{/str}}</h3>
            {{! These four are the grade, and nothing anywhere said what any of them meant or
                how they relate to the three readings the learner watched all the way through.
                A learner reasonably assumed the readings were the score. }}
            <p class="aibs-step-lead">{{#str}} skills:lead, mod_aibranchedscenario {{/str}}</p>
            <ul class="aibs-skill-list">
                {{#radar}}
                    <li class="aibs-skill {{tone}}">
                        <span class="aibs-skill-label">{{label}}</span>
                        <span class="aibs-skill-track">
                            <span class="aibs-skill-fill" style="width: {{percent}}%"></span>
                        </span>
                        {{! The number is its own element so it can be counted up to
                            without the per cent sign or the spoken standing being
                            rewritten on every frame of the animation. }}
                        <span class="aibs-skill-value">
                            <span class="aibs-skill-number" data-region="skillvalue"
                                  data-to="{{percent}}">{{percent}}</span>%
                            <span class="aibs-sr-only">{{standing}}</span>
                        </span>
                        <span class="aibs-skill-desc">{{description}}</span>
                    </li>
                {{/radar}}
            </ul>
                    </div>
        </section>

        {{#journeypages}}
            <section class="aibs-card aibs-deckslide aibs-slide aibs-journey {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" data-audio="{{pageaudiourl}}" hidden>
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
                <h3 class="aibs-h3">{{#str}} yourdecisions, mod_aibranchedscenario {{/str}}</h3>
                <ol class="aibs-journey-list">
                    {{#decisions}}
                        <li class="aibs-journey-item {{signalclass}}">
                            <div class="aibs-journey-head">
                                <span class="aibs-journey-seq" aria-hidden="true">{{seq}}</span>
                                <span class="aibs-journey-title">{{nodetitle}}</span>
                            </div>
                            <p class="aibs-journey-choice">{{choicetext}}</p>
                            <div class="aibs-prose aibs-prose-small">
                                {{#consequenceparas}}<p>{{.}}</p>{{/consequenceparas}}</div>
                            {{#hasfeedback}}
                                <div class="aibs-journey-feedback">
                                    <span class="aibs-journey-feedback-label">
                                        {{> mod_aibranchedscenario/feedbackmark }}
                                        {{#str}} whythismattered, mod_aibranchedscenario {{/str}}</span>
                                    <div class="aibs-prose aibs-prose-small">
                                        {{#feedbackparas}}<p>{{.}}</p>{{/feedbackparas}}</div>
                                </div>
                            {{/hasfeedback}}
                            {{#principle}}
                                <p class="aibs-journey-principle">
                                    <span class="aibs-chip-lead">
                                        {{#str}} principletested, mod_aibranchedscenario {{/str}}</span>
                                    {{principle}}
                                </p>
                            {{/principle}}
                        </li>
                    {{/decisions}}
                </ol>
                            </div>
            </section>
        {{/journeypages}}

        <section class="aibs-card aibs-deckslide aibs-slide aibs-lessons {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" data-audio="{{whatmatteredaudiourl}}" hidden>
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
            <h3 class="aibs-h3">{{#str}} whatmattered, mod_aibranchedscenario {{/str}}</h3>
            <ul class="aibs-lesson-list">
                {{#whatmattered}}
                    <li class="aibs-lesson"><span class="aibs-lesson-mark" aria-hidden="true">{{number}}</span>{{text}}</li>
                {{/whatmattered}}
            </ul>

                    </div>
        </section>

        {{! Its own page. Two headings and two numbered lists on one card overran the frame,
            and a debrief page that does not fit is the one screen a learner reads slowly -
            it grew a scrollbar rather than fitting, which is the thing the whole frame
            exists to avoid. They are separate subjects and they are separate pages. }}
        {{#hascritical}}
            <section class="aibs-card aibs-deckslide aibs-slide aibs-lessons
                     {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" hidden>
                {{#hasimage}}
                    <div class="aibs-scene">
                        <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                    </div>
                {{/hasimage}}
                <div class="aibs-node-body">
                    <h3 class="aibs-h3">
                        {{#str}} decisionsthatchanged, mod_aibranchedscenario {{/str}}</h3>
                    <ul class="aibs-lesson-list">
                        {{#criticaldecisions}}
                            <li class="aibs-lesson"><span class="aibs-lesson-mark"
                                 aria-hidden="true">{{number}}</span>{{text}}</li>
                        {{/criticaldecisions}}
                    </ul>
                </div>
            </section>
        {{/hascritical}}

        {{#haspractice}}
            <section class="aibs-card aibs-deckslide aibs-slide aibs-lessons {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" data-audio="{{practiceaudiourl}}" hidden>
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
                <h3 class="aibs-h3">{{#str}} applyitinpractice, mod_aibranchedscenario {{/str}}</h3>
                <ul class="aibs-lesson-list">
                    {{#practice}}
                        <li class="aibs-lesson"><span class="aibs-lesson-mark" aria-hidden="true">{{number}}</span>{{text}}</li>
                    {{/practice}}
                </ul>

                {{! "Source material" used to sit under the practice list. It was a second
                    subject on a page that already had five numbered items, it pushed the
                    page past its frame, and it told the learner about the scenario's
                    provenance rather than about their own performance - which is not what
                    a debrief is for. }}
                            </div>
            </section>
        {{/haspractice}}

        {{! The takeaways used to be a page of their own, directly after a page of advice,
            which is two pages of advice at the end of a debrief - one too many. They sit
            under the practice points now, and the actions that used to need a page of their
            own sit at the bottom of this one. }}
        {{#hastakeaways}}
            <section class="aibs-card aibs-deckslide aibs-slide aibs-lastpage {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" data-audio="{{takeawaysaudiourl}}" hidden>
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
                <h3 class="aibs-h3">{{#str}} takeaways, mod_aibranchedscenario {{/str}}</h3>
                <div class="aibs-takeaways">
                    {{#takeaways}}
                        {{! Numbered rather than marked with a repeated icon: the same
                            bookmark on every card labelled nothing, while a number tells
                            the learner how many of these there are and which one they are
                            reading. Counted in PHP - mustache cannot. }}
                        <article class="aibs-takeaway">
                            <span class="aibs-takeaway-mark" aria-hidden="true">{{number}}</span>
                            <h4 class="aibs-h4">{{heading}}</h4>
                            <div class="aibs-prose aibs-prose-small">{{#bodyparas}}<p>{{.}}</p>{{/bodyparas}}</div>
                        </article>
                    {{/takeaways}}
                </div>
            </div>
            </section>
        {{/hastakeaways}}

        {{! The closing card, always.
            It used to be drawn ONLY when a scenario had no takeaways - the reasoning being
            that a page saying "you have reached the end" tells a learner something they can
            already see. True of that page, and it meant that every normal scenario, which
            does have takeaways, simply stopped on a list with no ending at all: no
            completion, no result, and the Try again button buried under the last takeaway.
            A scenario that ends without closing leaves someone pressing the arrow to find
            out whether there is more. So the page stays - and earns itself by carrying the
            verdict rather than an announcement. }}
        <section class="aibs-card aibs-deckslide aibs-slide aibs-lastpage aibs-deckend {{^hasimage}}aibs-noscene{{/hasimage}}"
                 data-region="deckslide" hidden>
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            {{! The last thing a learner sees, and it was a heading and two buttons.
                A scenario that ends without saying so leaves someone clicking the arrow to
                check whether there is more. It closes on the verdict instead: the ending
                they earned, how well they decided, and how many decisions it took - all of
                which the debrief already carried and none of which it repeated at the end,
                so the result was on page two of nine and nothing was on page nine. }}
            <div class="aibs-node-body aibs-deckend-body">
                <span class="aibs-finish-burst" data-region="confetti" aria-hidden="true"></span>
                <span class="aibs-finish-mark" aria-hidden="true">
                    <svg viewBox="0 0 96 96" focusable="false">
                        <circle class="aibs-finish-ring" cx="48" cy="48" r="42" fill="none"
                                stroke="currentColor" stroke-width="3"/>
                        <path class="aibs-finish-tick" d="M30 49.5 42.5 62 66.5 36" fill="none"
                              stroke="currentColor" stroke-width="5" stroke-linecap="round"
                              stroke-linejoin="round"/>
                    </svg>
                </span>
                <h3 class="aibs-h3">{{#str}} attemptfinished, mod_aibranchedscenario {{/str}}</h3>

                <div class="aibs-endstats">
                    {{#outcomelabel}}
                        <div class="aibs-endstat">
                            <span class="aibs-endstat-value aibs-endstat-outcome">{{outcomelabel}}</span>
                            <span class="aibs-endstat-label">{{#str}} endstat:outcome, mod_aibranchedscenario {{/str}}</span>
                        </div>
                    {{/outcomelabel}}
                    <div class="aibs-endstat">
                        <span class="aibs-endstat-value" data-region="endscore">{{score}}%</span>
                        <span class="aibs-endstat-label">{{#str}} endstat:quality, mod_aibranchedscenario {{/str}}</span>
                    </div>
                    <div class="aibs-endstat">
                        <span class="aibs-endstat-value">{{decisions}}</span>
                        <span class="aibs-endstat-label">{{#str}} endstat:decisions, mod_aibranchedscenario {{/str}}</span>
                    </div>
                </div>

                <p class="aibs-prose">{{#str}} debriefendlead, mod_aibranchedscenario {{/str}}</p>
                {{> mod_aibranchedscenario/debriefactions }}
            </div>
        </section>

    </div>

    <nav class="aibs-deck-nav" aria-label="{{#str}} debriefpages, mod_aibranchedscenario {{/str}}">
        <button type="button" class="aibs-iconbtn" data-action="deckprev"
                title="{{#str}} deckprev, mod_aibranchedscenario {{/str}}"
                aria-label="{{#str}} deckprev, mod_aibranchedscenario {{/str}}">
            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M16 10H5m4.4-4.6L4.8 10l4.6 4.6" fill="none" stroke="currentColor"
                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <button type="button" class="aibs-iconbtn" data-action="decknext"
                title="{{#str}} decknext, mod_aibranchedscenario {{/str}}"
                aria-label="{{#str}} decknext, mod_aibranchedscenario {{/str}}">
            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4 10h11m-4.4-4.6L15.2 10l-4.6 4.6" fill="none" stroke="currentColor"
                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </nav>
</div>
