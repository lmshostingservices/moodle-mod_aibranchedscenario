{{!
    @template mod_aibranchedscenario/debrief

    The closing outcome and learning debrief for a finished attempt.

    Classes required for JS:
    * aibs-debrief

    Data attributes required for JS:
    * data-action="replay"
    * data-action="print"
    * data-action="deckprev"
    * data-action="decknext"
    * data-region="deck"
    * data-region="deckslide"
    * data-region="deckcount"

    Context variables required for this template:
    * outcome string Outcome band reached
    * outcomeclass string CSS modifier for the outcome band
    * endtone string Tone class for the score the closing card reports
    * endperfect bool Whether every decision was the best one available
    * endgood bool Whether the run landed in the good band
    * endwarn bool Whether it landed in the middle band
    * endbad bool Whether it landed in the low band
    * endverdict string One line saying how the run went, in the score's band
    * outcomelabel string Translated outcome band label
    * outcometitle string Title of the outcome node
    * outcomeparas string Outcome summary, array of plain-text paragraphs
    * awards array Behaviours this learner showed, derived from their decisions
    * hasawards bool Whether any were earned
    * score float Decision quality as a percentage
    * decisions int Number of decisions taken
    * radar array Skill values, each with label, percent and raw
    * slides array One per decision: what was chosen, the principle it tested, and where every option led
    * allowreplay bool Whether the learner may replay

    Example context (json):
    {
        "outcome": "mixed",
        "outcomeclass": "aibs-outcome-mixed",
        "endtone": "aibs-tone-warn",
        "endperfect": false,
        "endgood": false,
        "endwarn": true,
        "endbad": false,
        "endverdict": "A mixed run - there is ground to make up",
        "outcomelabel": "Mixed outcome",
        "outcometitle": "The line restarts, late",
        "outcomeparas": ["The fault was fixed, but two hours were lost."],
        "hasawards": true,
        "awards": [{"id": "recovered", "hidden": false, "title": "Strong recovery", "detail": "A decision went badly and you put it right."}],
        "score": 62.5,
        "decisions": 5,
        "radar": [{"skill": "clarity", "label": "Clarity", "percent": 70, "raw": 3}],
        "slides": [{"seq": 1, "nodetitle": "The fault nobody logged", "choicetext": "Log it now", "signal": "positive", "signalclass": "aibs-signal-positive", "principle": "Let the other person finish", "hasimage": false, "imageurl": "", "options": [{"letter": "A", "text": "Log it now", "signal": "positive", "signalclass": "aibs-signal-positive", "chosen": true, "noteparas": ["The best of the three: it costs you four minutes and it costs the night shift nothing."], "audiourl": ""}]}],
        "allowreplay": true
    }
}}
<div class="aibs-debrief aibs-deck aibs-enter" data-region="deck">

    <div class="aibs-deck-stage">

        <section class="aibs-card aibs-deckslide aibs-slide aibs-outcome {{outcomeclass}} {{^hasimage}}aibs-noscene{{/hasimage}}" data-region="deckslide" data-audio="{{outcomeaudiourl}}">
            {{#hasimage}}
                <div class="aibs-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
            <div class="aibs-outcome-head">
                <span class="aibs-outcome-badge">{{outcomelabel}}</span>
                {{! The only thing saying this number was a decision-quality score used to
                    be an aria-label, which everyone who can see the screen cannot read. }}
                <div class="aibs-score">
                    <span class="aibs-score-figure">
                        <span class="aibs-score-value">{{score}}</span>
                        <span class="aibs-score-unit">%</span>
                    </span>
                    <span class="aibs-score-label">
                        {{#str}} score, mod_aibranchedscenario {{/str}}</span>
                </div>
            </div>
            {{#outcometitle}}<h3 class="aibs-h3">{{outcometitle}}</h3>{{/outcometitle}}
            <div class="aibs-prose aibs-prose-lead">{{#outcomeparas}}<p>{{.}}</p>{{/outcomeparas}}</div>
            <p class="aibs-fineprint">{{#str}} decisionstaken, mod_aibranchedscenario, {{decisions}} {{/str}}</p>
                    </div>
        </section>

        <section class="aibs-card aibs-deckslide aibs-slide aibs-skills aibs-noscene" data-region="deckslide" hidden>
            <div class="aibs-node-body">
            <h3 class="aibs-h3">{{#str}} howyouhandledit, mod_aibranchedscenario {{/str}}</h3>
            {{! These four are the grade, and nothing anywhere said what any of them meant or
                how they relate to the three readings the learner watched all the way through.
                A learner reasonably assumed the readings were the score. }}
            <p class="aibs-step-lead">{{#str}} skills:lead, mod_aibranchedscenario {{/str}}</p>
            <ul class="aibs-skill-list">
                {{#radar}}
                    <li class="aibs-skill {{tone}}">
                        <span class="aibs-skill-label">{{label}}</span>
                        <span class="aibs-skill-track">
                            <span class="aibs-skill-fill" style="width: {{percent}}%"></span>
                        </span>
                        {{! The number is its own element so it can be counted up to
                            without the per cent sign or the spoken standing being
                            rewritten on every frame of the animation. }}
                        <span class="aibs-skill-value">
                            <span class="aibs-skill-number" data-region="skillvalue"
                                  data-to="{{percent}}">{{percent}}</span>%
                            <span class="aibs-sr-only">{{standing}}</span>
                        </span>
                        <span class="aibs-skill-desc">{{description}}</span>
                    </li>
                {{/radar}}
            </ul>
                    </div>
        </section>

        {{! ONE SLIDE PER DECISION.

            This is the debrief. It used to be a paged list of the decisions followed by
            four pages of closing advice - lessons learnt, critical decisions, practice
            points, takeaways - written independently of the scenario and of each other. A
            learner finished a story and was handed a general essay about it.

            A slide carries one decision: what they chose at the top, the reaction frame for
            that choice on the left, and every option that was open on the right, each with
            the paragraph saying where it would have led. The lesson is the comparison
            between the road taken and the roads not taken, so it needs no page of its own.

            Scripted, like the pages it replaces: the options arrive one at a time, each read
            by its own clip. The picture does not change between them - it is the reaction to
            what they actually chose, and it is what the whole slide is about. }}
        {{#slides}}
        <section class="aibs-card aibs-deckslide aibs-slide aibs-decisionslide aibs-scripted {{^hasimage}}aibs-noscene{{/hasimage}}"
                 data-region="deckslide" data-script="1" hidden>
            {{#hasimage}}
                <div class="aibs-scene aibs-script-scene">
                    <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy"
                         data-region="scriptimage">
                </div>
            {{/hasimage}}
            <div class="aibs-node-body">
                {{! What they chose, at the top. Everything below is the comparison, and a
                    comparison with nothing marked is a quiz. }}
                <p class="aibs-slide-eyebrow">
                    {{#str}} decisionnumber, mod_aibranchedscenario, {{seq}} {{/str}}</p>
                <h3 class="aibs-h3">{{nodetitle}}</h3>
                <p class="aibs-youchose {{signalclass}}">
                    <span class="aibs-chip-lead">
                        {{> mod_aibranchedscenario/feedbackmark }}
                        {{#str}} youchose, mod_aibranchedscenario {{/str}}</span>
                    {{choicetext}}
                </p>
                {{#principle}}
                    <p class="aibs-journey-principle">
                        <span class="aibs-chip-lead">
                            {{#str}} principletested, mod_aibranchedscenario {{/str}}</span>
                        {{principle}}
                    </p>
                {{/principle}}
                <ul class="aibs-option-list aibs-script-list">
                    {{#options}}
                        <li class="aibs-option aibs-script-item {{signalclass}} {{#chosen}}aibs-is-chosen{{/chosen}}"
                            data-region="readable" data-audio="{{audiourl}}">
                            <span class="aibs-option-letter" aria-hidden="true">{{letter}}</span>
                            <span class="aibs-script-body">
                                <span class="aibs-h4 aibs-option-text">{{text}}</span>
                                {{#chosen}}
                                    <span class="aibs-option-badge">
                                        {{#str}} youroption, mod_aibranchedscenario {{/str}}</span>
                                {{/chosen}}
                                <span class="aibs-prose aibs-prose-small">
                                    {{#noteparas}}<p>{{.}}</p>{{/noteparas}}</span>
                            </span>
                        </li>
                    {{/options}}
                </ul>
            </div>
        </section>
        {{/slides}}

        {{! The closing card, always.
            It used to be drawn ONLY when a scenario had no takeaways - the reasoning being
            that a page saying "you have reached the end" tells a learner something they can
            already see. True of that page, and it meant that every normal scenario, which
            does have takeaways, simply stopped on a list with no ending at all: no
            completion, no result, and the Try again button buried under the last takeaway.
            A scenario that ends without closing leaves someone pressing the arrow to find
            out whether there is more. So the page stays - and earns itself by carrying the
            verdict rather than an announcement. }}
        <section class="aibs-card aibs-deckslide aibs-slide aibs-lastpage aibs-deckend aibs-noscene
                 {{outcomeclass}} {{endtone}} {{#endperfect}}aibs-endperfect{{/endperfect}}"
                 data-region="deckslide" hidden>
            {{! The last thing a learner sees, and it was a heading and two buttons.
                A scenario that ends without saying so leaves someone clicking the arrow to
                check whether there is more. It closes on the verdict instead: the ending
                they earned, how well they decided, and how many decisions it took - all of
                which the debrief already carried and none of which it repeated at the end,
                so the result was on page two of nine and nothing was on page nine. }}
            <div class="aibs-node-body aibs-deckend-body">
                <span class="aibs-finish-burst" data-region="confetti" aria-hidden="true"></span>
                {{! One mark per band, and the shape says which: a tick when it went well, a
                    caution when it was mixed, a cross when it cost. A green exclamation mark
                    was neither - it read as a warning drawn in the colour of a success, which
                    tells a learner two contradictory things at once. }}
                <span class="aibs-finish-mark" aria-hidden="true">
                    <svg viewBox="0 0 96 96" focusable="false">
                        <circle class="aibs-finish-ring" cx="48" cy="48" r="42" fill="none"
                                stroke="currentColor" stroke-width="3"/>
                        {{#endgood}}
                            <path class="aibs-finish-tick" pathLength="56" d="M30 49.5 42.5 62 66.5 36" fill="none"
                                  stroke="currentColor" stroke-width="5" stroke-linecap="round"
                                  stroke-linejoin="round"/>
                        {{/endgood}}
                        {{#endwarn}}
                            {{! Sized to sit inside the ring rather than through it: the
                                first triangle was 42 units wide in a circle of radius 42,
                                so its corners crossed the stroke and the mark read as two
                                shapes colliding rather than as one caution sign. }}
                            <path class="aibs-finish-tick" pathLength="56" d="M48 33 65 62H31Z" fill="none"
                                  stroke="currentColor" stroke-width="4.5"
                                  stroke-linejoin="round"/>
                            <path d="M48 44v7" fill="none" stroke="currentColor"
                                  stroke-width="4.5" stroke-linecap="round"/>
                            <circle class="aibs-finish-dot" cx="48" cy="57" r="2.4"
                                    fill="currentColor"/>
                        {{/endwarn}}
                        {{#endbad}}
                            <path class="aibs-finish-tick" pathLength="56" d="M34 34 62 62M62 34 34 62" fill="none"
                                  stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
                        {{/endbad}}
                    </svg>
                </span>
                <p class="aibs-finish-eyebrow">{{#str}} attemptfinished, mod_aibranchedscenario {{/str}}</p>
                <h3 class="aibs-h3">{{endverdict}}</h3>

                <div class="aibs-endstats">
                    {{#outcomelabel}}
                        <div class="aibs-endstat">
                            <span class="aibs-endstat-value aibs-endstat-outcome aibs-outcome-badge">{{outcomelabel}}</span>
                            <span class="aibs-endstat-label">{{#str}} endstat:outcome, mod_aibranchedscenario {{/str}}</span>
                        </div>
                    {{/outcomelabel}}
                    <div class="aibs-endstat">
                        <span class="aibs-endstat-value aibs-endstat-score" data-region="endscore">{{score}}%</span>
                        <span class="aibs-endstat-label">{{#str}} endstat:quality, mod_aibranchedscenario {{/str}}</span>
                    </div>
                    <div class="aibs-endstat">
                        <span class="aibs-endstat-value">{{decisions}}</span>
                        <span class="aibs-endstat-label">{{#str}} endstat:decisions, mod_aibranchedscenario {{/str}}</span>
                    </div>
                </div>

                {{! WHAT THEY DID, NAMED. Not points and not "answered five questions" -
                    an achievement that counts actions rewards persistence, which the
                    learner already had. These name behaviours the scenario exists to
                    teach, so reading the list tells somebody something true about how
                    they handled it. Absent entirely when nothing was earned: an empty
                    trophy shelf says "you got none of them", which is not the note to
                    end on. }}
                {{#hasawards}}
                <div class="aibs-awards">
                    <p class="aibs-awards-heading">{{#str}} award:heading, mod_aibranchedscenario {{/str}}</p>
                    <ul class="aibs-awards-list">
                        {{#awards}}
                        <li class="aibs-award{{#hidden}} aibs-award-hidden{{/hidden}}">
                            <span class="aibs-award-mark" aria-hidden="true">
                                <svg viewBox="0 0 20 20" focusable="false">
                                    <path d="M4.5 10.4l3.4 3.4 7.6-7.6" fill="none" stroke="currentColor"
                                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="aibs-award-text">
                                <span class="aibs-award-title">{{title}}</span>
                                <span class="aibs-award-detail">{{detail}}</span>
                            </span>
                        </li>
                        {{/awards}}
                    </ul>
                </div>
                {{/hasawards}}

                <p class="aibs-prose">{{#str}} debriefendlead, mod_aibranchedscenario {{/str}}</p>
                {{> mod_aibranchedscenario/debriefactions }}
            </div>
        </section>

    </div>

    <nav class="aibs-deck-nav" aria-label="{{#str}} debriefpages, mod_aibranchedscenario {{/str}}">
        <button type="button" class="aibs-iconbtn" data-action="deckprev"
                title="{{#str}} deckprev, mod_aibranchedscenario {{/str}}"
                aria-label="{{#str}} deckprev, mod_aibranchedscenario {{/str}}">
            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M16 10H5m4.4-4.6L4.8 10l4.6 4.6" fill="none" stroke="currentColor"
                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <button type="button" class="aibs-iconbtn" data-action="decknext"
                title="{{#str}} decknext, mod_aibranchedscenario {{/str}}"
                aria-label="{{#str}} decknext, mod_aibranchedscenario {{/str}}">
            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4 10h11m-4.4-4.6L15.2 10l-4.6 4.6" fill="none" stroke="currentColor"
                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </nav>
</div>
