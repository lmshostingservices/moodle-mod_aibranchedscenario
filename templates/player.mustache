{{!
    @template mod_aibranchedscenario/player

    The shell of the branching scenario player.

    The shell renders the opening brief, the progress rail and the empty regions the
    AMD module fills as the learner moves through the scenario.

    Classes required for JS:
    * aibs-player
    * aibs-region-node
    * aibs-region-consequence
    * aibs-region-debrief
    * aibs-start

    Data attributes required for JS:
    * data-region="node"
    * data-region="consequence"
    * data-region="debrief"
    * data-action="start"
    * data-action="replay"

    Context variables required for this template:
    * cmid int Course module id
    * themeclass string CSS class applying the chosen accent theme
    * title string Activity name
    * scenariotitle string Title of the published scenario
    * subtitle string Scenario subtitle
    * role string The role the learner plays
    * hookparas string Opening situation, array of plain-text paragraphs
    * setting string Where the scenario takes place
    * published bool Whether a revision has been published
    * canattempt bool Whether this user may attempt the scenario
    * showtimeline bool Whether to render the progress rail
    * showmetrics bool Whether to render the dynamics meters
    * enableaudio bool Whether narration controls are offered
    * maxattempts int Attempt ceiling, 0 for unlimited
    * attemptsused int Attempts already started
    * attemptsleft int Attempts remaining, -1 for unlimited
    * stagecount int Longest number of decisions on any path
    * stages array Progress rail entries
    * metrics array Opening dynamics
    * hasprinciples bool Whether decision principles are shown
    * principles array Decision principles drawn from the source content
    * lessonslides array The opening lesson, one principle to a slide
    * openingimage string Scene image used on the opening slide, or empty

    Example context (json):
    {
        "cmid": 42,
        "themeclass": "aibs-theme-indigo",
        "title": "Reporting a hazard",
        "scenariotitle": "The vibrating machine",
        "subtitle": "A late shift, a fault nobody logged",
        "role": "You are the afternoon shift supervisor.",
        "hookparas": ["It is 2:40 pm."],
        "setting": "Packing line, main floor",
        "published": true,
        "canattempt": true,
        "showtimeline": true,
        "showmetrics": true,
        "enableaudio": false,
        "maxattempts": 0,
        "attemptsused": 0,
        "attemptsleft": -1,
        "stagecount": 5,
        "stages": [{"index": 1, "last": false}, {"index": 2, "last": true}],
        "metrics": [{"key": "trust", "label": "Trust", "value": 50}],
        "hasprinciples": true,
        "principles": [{"id": "p1", "title": "Report faults before the next shift", "summary": "Anything that can hurt someone is logged the moment it is seen."}]
    }
}}
<div class="aibs-player {{themeclass}}" data-region="player" data-cmid="{{cmid}}"
     data-stages="{{stagecount}}"
     data-metrics="{{#showmetrics}}1{{/showmetrics}}{{^showmetrics}}0{{/showmetrics}}"
     data-bandgreen="{{bandgreen}}" data-bandred="{{bandred}}"
     data-requirelisten="{{#requirelisten}}1{{/requirelisten}}{{^requirelisten}}0{{/requirelisten}}"
     data-audio="{{#enableaudio}}1{{/enableaudio}}{{^enableaudio}}0{{/enableaudio}}"
     data-replay="{{#allowreplay}}1{{/allowreplay}}{{^allowreplay}}0{{/allowreplay}}"
     data-debrief="{{#showdebrief}}1{{/showdebrief}}{{^showdebrief}}0{{/showdebrief}}">

    <div class="aibs-shell">

        <div class="aibs-topbar" data-region="topbar">
            <header class="aibs-masthead aibs-masthead-compact">
                <div class="aibs-masthead-text">
                    <h2 class="aibs-title">{{#scenariotitle}}{{scenariotitle}}{{/scenariotitle}}{{^scenariotitle}}{{title}}{{/scenariotitle}}</h2>
                </div>
                <div class="aibs-masthead-side">
                    {{! A record of what has already been decided, read only. There was no way
                        to look back at all: a learner three decisions in could not remember
                        what they had chosen at the first one, and going back to change it is
                        not the answer - undoing a consequence would make the score mean
                        nothing. This lets them look without letting them rewrite. }}
                    <details class="aibs-history" data-region="history" hidden>
                        {{! A mark, not a label. The rest of the bar is icon-only - the
                            narration toggle and the fullscreen control both carry their
                            name as hover text rather than printing it - and this was the
                            one control still spelling itself out in capitals above the
                            position chip. The name is still on the control and still read
                            to a screen reader. }}
                        <summary class="aibs-history-summary"
                                 title="{{#str}} journey:sofar, mod_aibranchedscenario {{/str}}"
                                 aria-label="{{#str}} journey:sofar, mod_aibranchedscenario {{/str}}">
                            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true"
                                 focusable="false">
                                <path d="M3.4 5.4h2M3.4 10h2M3.4 14.6h2" fill="none"
                                      stroke="currentColor" stroke-width="1.7"
                                      stroke-linecap="round"/>
                                <path d="M8.4 5.4h8.2M8.4 10h8.2M8.4 14.6h5.4" fill="none"
                                      stroke="currentColor" stroke-width="1.7"
                                      stroke-linecap="round"/>
                            </svg>
                            <span class="aibs-sr-only">
                                {{#str}} journey:sofar, mod_aibranchedscenario {{/str}}</span>
                        </summary>
                        <div class="aibs-history-body">
                            <p class="aibs-history-note">
                                {{#str}} journey:readonly, mod_aibranchedscenario {{/str}}</p>
                            <ol class="aibs-history-list" data-region="historylist"></ol>
                        </div>
                    </details>
                    {{#showtimeline}}
                        {{! This setting used to gate the row of numbered dots. The dots are
                            gone and it was left gating nothing at all, so turning it off had
                            no effect on anything. It gates the position indicator now, which
                            is what "show progress" means once there is only one of them. }}
                        <p class="aibs-position" data-region="position" aria-hidden="true"></p>
                    {{/showtimeline}}
                    {{#enableaudio}}
                        <button type="button" class="aibs-iconbtn aibs-audiobtn" data-action="mute"
                                data-region="mutebutton" aria-pressed="true" data-state="on"
                                title="{{#str}} narration:tipon, mod_aibranchedscenario {{/str}}"
                                aria-label="{{#str}} narration:tipon, mod_aibranchedscenario {{/str}}">
                            <span class="aibs-audiobtn-icon" aria-hidden="true">
                                <svg class="aibs-icon aibs-audioicon aibs-audioicon-on" viewBox="0 0 20 20"
                                     focusable="false">
                                    <path d="M4 8h2.4L10 4.8v10.4L6.4 12H4Z" fill="currentColor"/>
                                    <path d="M12.6 7.4a3.6 3.6 0 0 1 0 5.2M14.8 5.2a6.8 6.8 0 0 1 0 9.6"
                                          fill="none" stroke="currentColor" stroke-width="1.6"
                                          stroke-linecap="round"/>
                                </svg>
                                <svg class="aibs-icon aibs-audioicon aibs-audioicon-off" viewBox="0 0 20 20"
                                     focusable="false">
                                    <path d="M4 8h2.4L10 4.8v10.4L6.4 12H4Z" fill="currentColor"/>
                                    <path d="m13 7.6 4 4.8M17 7.6l-4 4.8" fill="none" stroke="currentColor"
                                          stroke-width="1.7" stroke-linecap="round"/>
                                </svg>
                                <svg class="aibs-icon aibs-audioicon aibs-audioicon-blocked" viewBox="0 0 20 20"
                                     focusable="false">
                                    <circle cx="10" cy="10" r="7.6" fill="none" stroke="currentColor"
                                            stroke-width="1.6"/>
                                    <path d="M8.4 6.8 13.4 10l-5 3.2Z" fill="currentColor"/>
                                </svg>
                                <svg class="aibs-icon aibs-audioicon aibs-audioicon-none" viewBox="0 0 20 20"
                                     focusable="false">
                                    <path d="M4 8h2.4L10 4.8v10.4L6.4 12H4Z" fill="currentColor"/>
                                    <path d="M12.6 10h4.4" fill="none" stroke="currentColor"
                                          stroke-width="1.7" stroke-linecap="round"/>
                                </svg>
                            </span>
                            {{! The word was carrying no information the mark does not: the
                                icon already shows on, off, blocked and none. It stays for a
                                screen reader, which cannot see which mark is drawn. }}
                            <span class="aibs-audiobtn-text aibs-sr-only" data-region="mutelabel">
                                {{#str}} narration:on, mod_aibranchedscenario {{/str}}</span>
                        </button>
                    {{/enableaudio}}
                    <button type="button" class="aibs-iconbtn" data-action="fullscreen"
                            data-region="fullscreenbutton"
                            title="{{#str}} fullscreen:enter, mod_aibranchedscenario {{/str}}"
                            aria-label="{{#str}} fullscreen:enter, mod_aibranchedscenario {{/str}}">
                        <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"
                             data-region="fullscreenicon">
                            <path d="M3.4 7.4V3.4h4M16.6 7.4V3.4h-4M3.4 12.6v4h4M16.6 12.6v4h-4"
                                  fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
            </header>

            <div class="aibs-statusbar">
                <p class="aibs-sr-only" data-region="railstatus" role="status" aria-live="polite"></p>

                {{#showmetrics}}
                    <div class="aibs-meters" data-region="meters">
                        {{#metrics}}
                            <div class="aibs-meter {{tone}}" data-metric="{{key}}" data-label="{{label}}"
                                 title="{{label}}">
                                <span class="aibs-meter-dial">
                                    <svg class="aibs-meter-ring" viewBox="0 0 36 36"
                                         aria-hidden="true" focusable="false">
                                        <circle class="aibs-meter-ringtrack" cx="18" cy="18" r="15"/>
                                        <circle class="aibs-meter-ringfill" cx="18" cy="18" r="15"
                                                data-region="meterfill" data-value="{{value}}"
                                                stroke-dasharray="0 94.25"/>
                                    </svg>
                                    {{! The three words took more of the bar than the
                                        readings did, so the mark stands for the name -
                                        which is on the control as hover text, in the
                                        legend in full, and said to a screen reader below.
                                        It sits inside the ring rather than beside it: out
                                        there it read as a loose mark between two dials
                                        and it was not obvious which one it belonged to.
                                        One definition of each mark, shared with the
                                        consequence screen. }}
                                    <span class="aibs-meter-mark" aria-hidden="true">
                                        {{> mod_aibranchedscenario/metricmark }}
                                    </span>
                                </span>
                                {{! The figure comes out of the ring and sits beside it,
                                    where it has room to be read at a size worth counting
                                    up to. }}
                                <span class="aibs-meter-value" data-region="metervalue"
                                      aria-hidden="true">{{value}}</span>
                                <span class="aibs-sr-only" data-region="meterspoken">
                                    {{label}} {{value}}</span>
                            </div>
                        {{/metrics}}
                    </div>

                    <details class="aibs-legend">
                        <summary class="aibs-legend-summary"
                                 title="{{#str}} metrics:explain, mod_aibranchedscenario {{/str}}"
                                 aria-label="{{#str}} metrics:explain, mod_aibranchedscenario {{/str}}">
                            <span class="aibs-legend-icon" aria-hidden="true"></span>
                            <span class="aibs-sr-only">
                                {{#str}} metrics:explain, mod_aibranchedscenario {{/str}}</span>
                        </summary>
                        <div class="aibs-legend-body">
                            <p class="aibs-legend-lead">{{#str}} metrics:lead, mod_aibranchedscenario {{/str}}</p>
                            <div class="aibs-legend-grid">
                                <div class="aibs-legend-item" data-metric="engagement">
                                    <span class="aibs-legend-name">
                                        {{#str}} metric:engagement, mod_aibranchedscenario {{/str}}</span>
                                    <p class="aibs-legend-desc">
                                        {{#str}} metric:engagementdesc, mod_aibranchedscenario {{/str}}</p>
                                    <p class="aibs-legend-move aibs-legend-up">
                                        <span>{{#str}} metrics:up, mod_aibranchedscenario {{/str}}</span>
                                        {{#str}} metric:engagementup, mod_aibranchedscenario {{/str}}</p>
                                    <p class="aibs-legend-move aibs-legend-down">
                                        <span>{{#str}} metrics:down, mod_aibranchedscenario {{/str}}</span>
                                        {{#str}} metric:engagementdown, mod_aibranchedscenario {{/str}}</p>
                                </div>
                                <div class="aibs-legend-item" data-metric="trust">
                                    <span class="aibs-legend-name">
                                        {{#str}} metric:trust, mod_aibranchedscenario {{/str}}</span>
                                    <p class="aibs-legend-desc">
                                        {{#str}} metric:trustdesc, mod_aibranchedscenario {{/str}}</p>
                                    <p class="aibs-legend-move aibs-legend-up">
                                        <span>{{#str}} metrics:up, mod_aibranchedscenario {{/str}}</span>
                                        {{#str}} metric:trustup, mod_aibranchedscenario {{/str}}</p>
                                    <p class="aibs-legend-move aibs-legend-down">
                                        <span>{{#str}} metrics:down, mod_aibranchedscenario {{/str}}</span>
                                        {{#str}} metric:trustdown, mod_aibranchedscenario {{/str}}</p>
                                </div>
                                <div class="aibs-legend-item" data-metric="tension">
                                    <span class="aibs-legend-name">
                                        {{#str}} metric:tension, mod_aibranchedscenario {{/str}}</span>
                                    <p class="aibs-legend-desc">
                                        {{#str}} metric:tensiondesc, mod_aibranchedscenario {{/str}}</p>
                                    <p class="aibs-legend-move aibs-legend-up">
                                        <span>{{#str}} metrics:up, mod_aibranchedscenario {{/str}}</span>
                                        {{#str}} metric:tensionup, mod_aibranchedscenario {{/str}}</p>
                                    <p class="aibs-legend-move aibs-legend-down">
                                        <span>{{#str}} metrics:down, mod_aibranchedscenario {{/str}}</span>
                                        {{#str}} metric:tensiondown, mod_aibranchedscenario {{/str}}</p>
                                </div>
                            </div>
                            <p class="aibs-legend-note">
                                {{#str}} metrics:noright, mod_aibranchedscenario {{/str}}</p>
                            <p class="aibs-legend-note">
                                {{#str}} metrics:gradedby, mod_aibranchedscenario {{/str}}</p>
                        </div>
                    </details>
                {{/showmetrics}}
            </div>
        </div>

        <div class="aibs-stage">

            <section class="aibs-brief" data-region="brief">

                <div class="aibs-deck" data-region="deck" data-slide="0">
                    <div class="aibs-deck-stage">

                        <article class="aibs-card aibs-deckslide aibs-slide" data-region="deckslide">
                            {{#openingimage}}
                                <div class="aibs-scene">
                                    <img src="{{openingimage}}" alt="" class="aibs-scene-img" loading="lazy">
                                </div>
                            {{/openingimage}}
                            <div class="aibs-node-body">
                                <span class="aibs-chip">{{#str}} lesson:situation, mod_aibranchedscenario {{/str}}</span>
                                <h3 class="aibs-h3">{{#scenariotitle}}{{scenariotitle}}{{/scenariotitle}}{{^scenariotitle}}{{title}}{{/scenariotitle}}</h3>
                                {{#role}}<p class="aibs-role">{{role}}</p>{{/role}}
                                <div class="aibs-prose">{{#hookparas}}<p>{{.}}</p>{{/hookparas}}</div>
                            </div>
                        </article>

                        {{#lessonslides}}
                            <article class="aibs-card aibs-deckslide aibs-slide" data-region="deckslide"
                                     data-audio="{{audiourl}}" hidden>
                                {{#hasimage}}
                                    <div class="aibs-scene">
                                        <img src="{{imageurl}}" alt="" class="aibs-scene-img" loading="lazy">
                                    </div>
                                {{/hasimage}}
                                <div class="aibs-node-body">
                                    <span class="aibs-chip">
                                        {{#str}} lesson:number, mod_aibranchedscenario, {{number}} {{/str}}</span>
                                    <h3 class="aibs-h3">{{title}}</h3>
                                    <div class="aibs-prose aibs-lessoncard aibs-lessoncard-lead">
                                        {{#summaryparas}}<p>{{.}}</p>{{/summaryparas}}</div>
                                    {{#hasexample}}
                                        <div class="aibs-lessoncard aibs-lessoncard-good">
                                            <span class="aibs-lessoncard-label">
                                                <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true"
                                                     focusable="false">
                                                    <path d="M4.4 3.6h11.2a1.8 1.8 0 0 1 1.8 1.8v6.4a1.8 1.8 0 0 1-1.8 1.8H8.6l-3.8 2.8v-2.8h-.4a1.8 1.8 0 0 1-1.8-1.8V5.4a1.8 1.8 0 0 1 1.8-1.8Z"
                                                          fill="none" stroke="currentColor" stroke-width="1.6"
                                                          stroke-linejoin="round"/>
                                                </svg>
                                                {{#str}} lesson:saythis, mod_aibranchedscenario {{/str}}</span>
                                            <p class="aibs-lessoncard-text">{{example}}</p>
                                        </div>
                                    {{/hasexample}}
                                    {{#haspitfall}}
                                        <div class="aibs-lessoncard aibs-lessoncard-bad">
                                            <span class="aibs-lessoncard-label">
                                                <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true"
                                                     focusable="false">
                                                    <circle cx="10" cy="10" r="7.4" fill="none"
                                                            stroke="currentColor" stroke-width="1.6"/>
                                                    <path d="M4.9 4.9l10.2 10.2" fill="none"
                                                          stroke="currentColor" stroke-width="1.7"
                                                          stroke-linecap="round"/>
                                                </svg>
                                                {{#str}} lesson:notthis, mod_aibranchedscenario {{/str}}</span>
                                            <p class="aibs-lessoncard-text">{{pitfall}}</p>
                                        </div>
                                    {{/haspitfall}}
                                </div>
                            </article>
                        {{/lessonslides}}

                        <article class="aibs-card aibs-deckslide aibs-slide aibs-deckend
                                 {{^openingimage}}aibs-noscene{{/openingimage}}"
                                 data-region="deckslide" hidden>
                            {{#openingimage}}
                                <div class="aibs-scene">
                                    <img src="{{openingimage}}" alt="" class="aibs-scene-img"
                                         loading="lazy">
                                </div>
                            {{/openingimage}}
                            <div class="aibs-node-body">
                            {{! The heading has to describe what is under it. It used to say
                                "Ready when you are" over a "See how you did" button, over a
                                "not published yet" notice, and over "no attempts left" - one
                                sentence standing in front of five different situations. }}
                            {{#canattempt}}{{#published}}
                                {{#hasopen}}
                                    <h3 class="aibs-h3">
                                        {{#str}} lesson:resumehead, mod_aibranchedscenario {{/str}}</h3>
                                    <p class="aibs-step-lead">
                                        {{#str}} lesson:resumelead, mod_aibranchedscenario {{/str}}</p>
                                {{/hasopen}}
                                {{^hasopen}}
                                    <h3 class="aibs-h3">
                                        {{#str}} lesson:beginhead, mod_aibranchedscenario {{/str}}</h3>
                                    <p class="aibs-step-lead">
                                        {{#str}} lesson:readylead, mod_aibranchedscenario {{/str}}</p>
                                {{/hasopen}}
                            {{/published}}{{/canattempt}}


                <div class="aibs-brief-actions">
                    {{#canattempt}}
                        {{#published}}
                            {{! A finished attempt is the learner's to read again. Offering only
                                "Begin the scenario" spent another attempt and put the earlier
                                result out of reach. }}

                            {{#hasopen}}
                                <button type="button" class="aibs-btn aibs-btn-primary aibs-start" data-action="start">
                                    {{#str}} resumescenario, mod_aibranchedscenario {{/str}}
                                </button>
                            {{/hasopen}}
                            {{#canstartnew}}
                                <button type="button" class="aibs-btn aibs-btn-primary aibs-start"
                                    data-action="start">
                                    {{#hasfinished}}{{#str}} tryagain, mod_aibranchedscenario {{/str}}{{/hasfinished}}
                                    {{^hasfinished}}{{#str}} beginscenario, mod_aibranchedscenario {{/str}}{{/hasfinished}}
                                </button>
                            {{/canstartnew}}
                            {{! Reading a finished run again is a quiet second option here, not
                                the blue button: this screen's job is to start the scenario.
                                The full result has its own screen at the end. }}
                            {{#hasfinished}}
                                {{#showdebrief}}
                                    <button type="button" class="aibs-btn aibs-btn-ghost"
                                        data-action="showresult" data-attemptid="{{finishedattemptid}}">
                                        {{#str}} seeyourresult, mod_aibranchedscenario {{/str}}
                                    </button>
                                {{/showdebrief}}
                            {{/hasfinished}}
                            {{^canstartnew}}
                                {{^hasfinished}}
                                    {{^hasopen}}
                                        <p class="aibs-notice">
                                            {{#str}} noattemptsleft, mod_aibranchedscenario {{/str}}</p>
                                    {{/hasopen}}
                                {{/hasfinished}}
                            {{/canstartnew}}
                        {{/published}}
                    {{/canattempt}}
                    {{^published}}
                        <p class="aibs-notice">{{#str}} notpublishedyet, mod_aibranchedscenario {{/str}}</p>
                    {{/published}}
                    {{#published}}
                        {{^canattempt}}
                            <p class="aibs-notice">{{#str}} previewonly, mod_aibranchedscenario {{/str}}</p>
                        {{/canattempt}}
                    {{/published}}
                </div>

                {{#maxattempts}}
                    <p class="aibs-fineprint">
                        {{#str}} attemptsremaining, mod_aibranchedscenario, {{attemptsleft}} {{/str}}
                    </p>
                {{/maxattempts}}
                            </div>
                        </article>

                    </div>

                    <nav class="aibs-deck-nav" aria-label="{{#str}} lesson:pages, mod_aibranchedscenario {{/str}}">
                        <button type="button" class="aibs-iconbtn" data-action="deckprev"
                                title="{{#str}} deckprev, mod_aibranchedscenario {{/str}}"
                                aria-label="{{#str}} deckprev, mod_aibranchedscenario {{/str}}">
                            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                                <path d="M16 10H5m4.4-4.6L4.8 10l4.6 4.6" fill="none" stroke="currentColor"
                                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>

                        <button type="button" class="aibs-iconbtn" data-action="decknext"
                                title="{{#str}} decknext, mod_aibranchedscenario {{/str}}"
                                aria-label="{{#str}} decknext, mod_aibranchedscenario {{/str}}">
                            <svg class="aibs-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                                <path d="M4 10h11m-4.4-4.6L15.2 10l-4.6 4.6" fill="none" stroke="currentColor"
                                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </nav>
                </div>
</section>

            <section class="aibs-region" data-region="node" aria-live="polite" hidden></section>
            <section class="aibs-region" data-region="consequence" aria-live="polite" hidden></section>
            <section class="aibs-region" data-region="debrief" aria-live="polite" hidden></section>

            <div class="aibs-loading" data-region="loading" hidden>
                <span class="aibs-spinner" aria-hidden="true"></span>
                <span class="aibs-loading-text">{{#str}} working, mod_aibranchedscenario {{/str}}</span>
            </div>

            <div class="aibs-error" data-region="error" role="alert" hidden></div>
        </div>
    </div>
</div>
